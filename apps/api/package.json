{
  "name": "@stablemanager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state --port 8787 --ip 127.0.0.1",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply stablemanager --local --persist-to .wrangler/state",
    "seed:local": "wrangler d1 execute stablemanager --local --persist-to .wrangler/state --file ../../seed-horses.sql",
    "db:migrate:remote": "wrangler d1 migrations apply stablemanager --remote",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stablemanager/shared": "workspace:*",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250317.0",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2",
    "wrangler": "^4.4.0"
  }
}
