{
  "name": "stablemanager-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @stablemanager/web --filter @stablemanager/api dev",
    "dev:web": "pnpm --filter @stablemanager/web dev",
    "dev:api": "pnpm --filter @stablemanager/api dev",
    "build": "pnpm --filter @stablemanager/shared build && pnpm --filter @stablemanager/web build && pnpm --filter @stablemanager/api build",
    "deploy": "pnpm build && pnpm --filter @stablemanager/api deploy",
    "db:generate": "pnpm --filter @stablemanager/api db:generate",
    "db:migrate:local": "pnpm --filter @stablemanager/api db:migrate:local",
    "db:seed:local": "pnpm --filter @stablemanager/api seed:local",
    "db:seed:remote": "pnpm --filter @stablemanager/api seed:remote",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @stablemanager/api test:api"
  },
  "engines": {
    "node": ">=20"
  }
}
